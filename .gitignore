```gitignore
# ============================================================
# macOS
# ============================================================
.DS_Store
.AppleDouble
.LSOverride

# ============================================================
# IDEs / Editors
# ============================================================
.vscode/
.idea/
*.swp
*.swo

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# ============================================================
# Environment / Secrets
# ============================================================
.env
.env.*
!.env.example

*.pem
*.key
*.pfx
*.p12

# ============================================================
# Terraform
# ============================================================

# Local Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform saved plan files
tfplan
*.tfplan

# Local variable files - may contain secrets
*.tfvars
*.tfvars.json

# Allow safe variable examples
!*.tfvars.example
!*.tfvars.json.example

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# IMPORTANT:
# .terraform.lock.hcl MUST be committed.
# Do NOT add it to .gitignore.

# ============================================================
# Databricks
# ============================================================
.databricks/
*.dbc

# ============================================================
# Airflow
# ============================================================
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/webserver_config.py

# ============================================================
# Docker
# ============================================================
.docker/

# ============================================================
# Logs / Temporary Files
# ============================================================
*.log
tmp/
temp/
.cache/

# ============================================================
# Local Credentials / Configuration
# ============================================================
credentials.json
secrets.json
local.settings.json
```
